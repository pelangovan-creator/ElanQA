// QA Pilot data model.
// Dev uses SQLite; `npm run prisma:postgres` generates schema.postgres.prisma for Docker/production.
// Enumerations are stored as strings and validated in code (src/common/enums.ts) so the
// same schema works on both SQLite and PostgreSQL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── Identity & access ─────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String // Admin | QALead | Tester | Developer | Client
  active       Boolean  @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships ProjectMember[]
  auditLogs   AuditLog[]
}

model Project {
  id          String   @id @default(cuid())
  key         String   @unique // short code, e.g. "SHOP"
  name        String
  client      String?
  description String?
  status      String   @default("Active") // Active | OnHold | Closed | Archived
  startDate   DateTime?
  endDate     DateTime?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members        ProjectMember[]
  settings       ProjectSetting[]
  documents      RequirementDocument[]
  requirements   RequirementItem[]
  questions      ClarificationQuestion[]
  scenarios      TestScenario[]
  testCases      TestCase[]
  testData       TestDataItem[]
  artefacts      Artefact[]
  environments   TestEnvironment[]
  scripts        AutomationScript[]
  runs           TestRun[]
  defects        Defect[]
  monitorChecks  MonitorCheck[]
  reports        Report[]
  auditLogs      AuditLog[]
  counters       IdCounter[]
}

/// Project-level role override. If absent the user's global role applies.
model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  role      String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
}

/// Key/value settings per project. `encrypted` values are AES-256-GCM ciphertext
/// (Jira tokens, test credentials, webhook URLs...).
model ProjectSetting {
  id        String   @id @default(cuid())
  projectId String
  key       String
  value     String
  encrypted Boolean  @default(false)
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, key])
}

/// Sequential human-readable IDs per project & prefix (REQ, Q, TS, TC, TD, DEF, RUN...).
model IdCounter {
  id        String @id @default(cuid())
  projectId String
  prefix    String
  value     Int    @default(0)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, prefix])
}

model AuditLog {
  id         String   @id @default(cuid())
  projectId  String?
  userId     String?
  action     String // CREATE | UPDATE | DELETE | LOGIN | APPROVE | REJECT | EXPORT | RUN ...
  entityType String
  entityId   String?
  before     String? // JSON snapshot
  after      String? // JSON snapshot
  ip         String?
  createdAt  DateTime @default(now())

  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@index([entityType, entityId])
}

// ───────────────────────────── Module 1: requirements ─────────────────────────────

model RequirementDocument {
  id        String   @id @default(cuid())
  projectId String
  docKey    String // e.g. "DOC-001" - stable across versions
  title     String
  docType   String // BRD | FRD | SRS | UserStory | Wireframe | Email | ChangeRequest | Other
  createdAt DateTime @default(now())

  project  Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions DocumentVersion[]

  @@unique([projectId, docKey])
}

model DocumentVersion {
  id            String   @id @default(cuid())
  documentId    String
  version       Int
  fileName      String
  mimeType      String
  storagePath   String // original file stored unchanged
  sha256        String
  sizeBytes     Int
  extractedText String? // full plain text
  wordCountOriginal  Int?
  wordCountExtracted Int?
  reverseCheckOk     Boolean?
  reverseCheckJson   String? // { originalWords, extractedWords, missing:[{word,count}], extra:[...] }
  ocrUsed       Boolean  @default(false)
  warnings      String? // JSON array of parser warnings
  itemCount     Int      @default(0)
  parseStatus   String   @default("Pending") // Pending | Parsed | Failed
  parseError    String?
  diffJson      String? // added/modified/removed vs previous version
  uploadedById  String?
  createdAt     DateTime @default(now())

  document RequirementDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  items    RequirementItem[]

  @@unique([documentId, version])
}

/// Atomic requirement item: every sentence, bullet, table row/cell, header, footnote...
model RequirementItem {
  id            String   @id @default(cuid())
  projectId     String
  versionId     String
  reqId         String // e.g. REQ-001.03
  parentReqId   String?
  sequence      Int
  section       String?
  sectionTitle  String?
  page          Int?
  sourceKind    String // Sentence | Bullet | TableRow | TableCell | Header | Footnote | Note | Caption | Appendix
  text          String
  category      String // Functional | NonFunctional | BusinessRule | Validation | UIUX | Data | Integration | Constraint | Assumption | OutOfScope | Informational
  subCategory   String? // performance, security, usability, accessibility...
  ambiguousTerms String? // JSON array
  coverageStatus String  @default("Unmapped") // Unmapped | Covered | Informational | Acknowledged
  noTestReason  String?
  acknowledgedById String?
  acknowledgedAt   DateTime?
  changeType    String? // Added | Modified | Unchanged (vs previous version)
  previousText  String? // text in the previous version when Modified
  isCurrent     Boolean  @default(true) // false once superseded by a newer document version
  aiGenerated   Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  project   Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version   DocumentVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  questions ClarificationQuestion[]
  scenarioLinks ScenarioRequirement[]
  testCaseLinks TestCaseRequirement[]

  @@unique([versionId, reqId])
  @@index([projectId, reqId])
  @@index([projectId, isCurrent])
}

// ───────────────────────────── Module 2: artefacts ─────────────────────────────

model ClarificationQuestion {
  id            String   @id @default(cuid())
  projectId     String
  qId           String // Q-001
  requirementId String?
  sectionPage   String?
  question      String
  category      String // Ambiguity | MissingInfo | Conflict | Assumption | EdgeCase
  raisedBy      String?
  raisedDate    DateTime @default(now())
  assignedTo    String?
  priority      String   @default("Medium")
  status        String   @default("Open") // Open | Answered | Closed
  clientAnswer  String?
  answerDate    DateTime?
  impact        String?
  reviewStatus  String   @default("PendingReview") // PendingReview | Approved | Rejected
  aiGenerated   Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requirement RequirementItem? @relation(fields: [requirementId], references: [id], onDelete: SetNull)

  @@unique([projectId, qId])
}

model TestScenario {
  id            String   @id @default(cuid())
  projectId     String
  scenarioId    String // TS-001
  module        String
  description   String
  scenarioType  String // Positive | Negative | Edge | EndToEnd
  priority      String // High | Medium | Low
  preconditions String?
  reviewStatus  String   @default("PendingReview")
  reviewComment String?
  aiGenerated   Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  project      Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requirements ScenarioRequirement[]
  testCases    TestCase[]

  @@unique([projectId, scenarioId])
}

model ScenarioRequirement {
  scenarioId    String
  requirementId String

  scenario    TestScenario    @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  requirement RequirementItem @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  @@id([scenarioId, requirementId])
}

model TestCase {
  id                  String   @id @default(cuid())
  projectId           String
  tcId                String // TC-0001
  scenarioId          String?
  module              String
  title               String
  description         String?
  preconditions       String?
  testDataRef         String?
  steps               String // JSON: [{no, action, expected, actual?, status?}]
  status              String   @default("NotRun") // NotRun | Pass | Fail | Blocked | Skipped
  priority            String   @default("Medium")
  severityIfFailed    String?
  testType            String // Smoke | Functional | API | Security ...
  technique           String // EquivalencePartitioning | BVA | DecisionTable ...
  automationCandidate Boolean  @default(false)
  suites              String? // JSON array: Smoke | Sanity | Regression
  automatedScriptId   String?
  actualResult        String?
  executedBy          String?
  executionDate       DateTime?
  comments            String?
  reviewStatus        String   @default("PendingReview")
  reviewComment       String?
  needsRegeneration   Boolean  @default(false)
  aiGenerated         Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  project      Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scenario     TestScenario?         @relation(fields: [scenarioId], references: [id], onDelete: SetNull)
  requirements TestCaseRequirement[]
  results      TestResult[]
  defects      Defect[]

  @@unique([projectId, tcId])
}

model TestCaseRequirement {
  testCaseId    String
  requirementId String

  testCase    TestCase        @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  requirement RequirementItem @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  @@id([testCaseId, requirementId])
}

model TestDataItem {
  id               String   @id @default(cuid())
  projectId        String
  dataId           String // TD-001
  tcIds            String? // JSON array of TC IDs
  fieldName        String
  dataType         String
  validValues      String? // JSON array
  invalidValues    String? // JSON array
  boundaryValues   String? // JSON {minMinus1, min, minPlus1, maxMinus1, max, maxPlus1}
  specialChars     String?
  emptyNull        String?
  expectedBehaviour String?
  environment      String?
  notes            String?
  reviewStatus     String   @default("PendingReview")
  aiGenerated      Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, dataId])
}

/// Document-style artefacts (Test Plan, Test Techniques doc) stored as structured JSON
/// with version history and approve/reject workflow.
model Artefact {
  id            String   @id @default(cuid())
  projectId     String
  type          String // TestPlan | TestTechniques
  title         String
  version       Int      @default(1)
  content       String // JSON sections
  reviewStatus  String   @default("PendingReview")
  aiGenerated   Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

/// Review trail for any reviewable entity (approve / reject with comment).
model ReviewAction {
  id         String   @id @default(cuid())
  projectId  String
  entityType String
  entityId   String
  action     String // Approve | Reject | RequestChanges
  comment    String?
  userId     String
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
}

// ───────────────────────────── Module 3: execution ─────────────────────────────

model TestEnvironment {
  id                 String   @id @default(cuid())
  projectId          String
  name               String // QA | UAT | Staging
  baseUrl            String
  browsers           String   @default("[\"chromium\"]") // JSON
  viewport           String? // JSON {width,height} or device name
  credentialsEnc     String? // encrypted JSON { role: { username, password } }
  modulePaths        String? // JSON { "Login": "/login", ... } - module → URL path
  envType            String   @default("QA") // QA | UAT | Staging
  workers            Int      @default(2)
  retries            Int      @default(0)
  timeoutMs          Int      @default(30000)
  lastProbe          String? // JSON: discovered labels/buttons per module path
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  project Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  runs    TestRun[]
}

model AutomationScript {
  id         String   @id @default(cuid())
  projectId  String
  testCaseId String?
  name       String
  path       String // relative path inside generated Playwright project
  content    String
  kind       String   @default("spec") // spec | pageObject | fixture | data
  aiGenerated Boolean @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model TestRun {
  id            String   @id @default(cuid())
  projectId     String
  runId         String // RUN-0001
  environmentId String?
  build         String?
  mode          String // All | Selected | Module | Priority | Smoke | Regression | RerunFailed | Manual
  filter        String? // JSON
  status        String   @default("Queued") // Queued | Running | Completed | Aborted | Error
  kind          String   @default("Automated") // Automated | Manual
  summary       String? // JSON: browsers, notAutomated TC IDs, error
  total         Int      @default(0)
  passed        Int      @default(0)
  failed        Int      @default(0)
  blocked       Int      @default(0)
  skipped       Int      @default(0)
  log           String?
  executedById  String?
  startedAt     DateTime?
  finishedAt    DateTime?
  createdAt     DateTime @default(now())

  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  environment TestEnvironment? @relation(fields: [environmentId], references: [id], onDelete: SetNull)
  results     TestResult[]

  @@unique([projectId, runId])
}

model TestResult {
  id           String   @id @default(cuid())
  runId        String
  testCaseId   String
  status       String // Pass | Fail | Blocked | Skipped
  title        String?
  retries      Int      @default(0)
  browser      String?
  durationMs   Int?
  error        String?
  stepResults  String? // JSON per-step status + actual
  consoleLog   String?
  networkLog   String?
  executedBy   String?
  createdAt    DateTime @default(now())

  run         TestRun      @relation(fields: [runId], references: [id], onDelete: Cascade)
  testCase    TestCase     @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  attachments Attachment[]
}

// ───────────────────────────── Module 4: defects ─────────────────────────────

model Defect {
  id              String   @id @default(cuid())
  projectId       String
  defectId        String // DEF-0001
  title           String
  description     String?
  module          String?
  requirementId   String? // human REQ id(s)
  testCaseId      String?
  testRunId       String?
  environment     String?
  build           String?
  browserDeviceOs String?
  preconditions   String?
  stepsToReproduce String?
  testDataUsed    String?
  expectedResult  String?
  actualResult    String?
  severity        String // Blocker | Critical | Major | Minor | Trivial
  priority        String // P1 | P2 | P3 | P4
  defectType      String // Functional | UI | Performance | Security | Data | Usability | Compatibility
  status          String   @default("New")
  isDraft         Boolean  @default(false)
  reportedBy      String?
  reportedDate    DateTime @default(now())
  assignedTo      String?
  rootCause       String?
  fixVersion      String?
  targetDate      DateTime?
  retestResult    String?
  closedDate      DateTime?
  duplicateOfId   String?
  duplicateCandidates String? // JSON [{defectId, id, score, reason}] suggested when the draft was created
  testResultId    String? // the failed result that produced this defect (auto-created)
  jiraKey         String?
  jiraUrl         String?
  jiraStatus      String?
  jiraSyncedAt    DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  testCase    TestCase?       @relation(fields: [testCaseId], references: [id], onDelete: SetNull)
  attachments Attachment[]
  history     DefectHistory[]

  @@unique([projectId, defectId])
  @@index([projectId, status])
}

model DefectHistory {
  id        String   @id @default(cuid())
  defectId  String
  userId    String?
  kind      String // Comment | StatusChange | FieldChange
  field     String?
  fromValue String?
  toValue   String?
  comment   String?
  createdAt DateTime @default(now())

  defect Defect @relation(fields: [defectId], references: [id], onDelete: Cascade)
}

model Attachment {
  id           String   @id @default(cuid())
  defectId     String?
  testResultId String?
  kind         String // FailureScreenshot | FullPageScreenshot | AnnotatedScreenshot | Video | Trace | ConsoleLog | NetworkLog | Manual
  fileName     String
  mimeType     String
  storagePath  String
  sizeBytes    Int
  createdAt    DateTime @default(now())

  defect     Defect?     @relation(fields: [defectId], references: [id], onDelete: Cascade)
  testResult TestResult? @relation(fields: [testResultId], references: [id], onDelete: Cascade)
}

// ───────────────────────────── Modules 6-8: monitoring & reports ─────────────────────────────

model MonitorCheck {
  id         String   @id @default(cuid())
  projectId  String
  slot       String // Morning | Evening | Manual
  scheduledFor String? // "2026-10-31 Morning" in the project time zone - one check per slot per day
  late       Boolean  @default(false) // run after the slot time (e.g. server was down)
  summary    String // JSON alert summary
  criticalCount Int   @default(0)
  breachedCount Int   @default(0)
  delivered  String? // JSON of channels delivered
  triggeredBy String? // user id for manual checks
  createdAt  DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, scheduledFor])
  @@index([projectId, createdAt])
}

model Report {
  id          String   @id @default(cuid())
  projectId   String
  type        String // DSR | WSR | DefectReport | Closure
  title       String
  periodFrom  DateTime?
  periodTo    DateTime?
  content     String // JSON (auto-filled, then edited)
  status      String   @default("Draft") // Draft | Final | Sent | SignedOff
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}
