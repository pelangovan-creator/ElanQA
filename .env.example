# ---------- API ----------
PORT=4000
NODE_ENV=development
# SQLite for local dev. For Postgres use docker-compose (sets its own DATABASE_URL).
DATABASE_URL="file:./dev.db"
# JWT signing secret - generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
# 32-byte key (64 hex chars) for AES-256-GCM encryption of credentials / API keys
# generate with: openssl rand -hex 32
ENCRYPTION_KEY=
# Comma-separated allowed web origins
CORS_ORIGIN=http://localhost:5173
# Where uploaded files, screenshots, videos and traces are stored
STORAGE_DIR=./storage

# ---------- Seed admin (first run only) ----------
SEED_ADMIN_EMAIL=admin@qapilot.local
SEED_ADMIN_PASSWORD=ChangeMe!123

# ---------- AI layer (optional - rule-based fallback is used when unset) ----------
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# ---------- Scheduler (Phase 7) ----------
MONITOR_TIMEZONE=Asia/Kolkata
# Default check times (HH:MM in MONITOR_TIMEZONE); each project can change them on the Monitoring page.
MONITOR_MORNING_TIME=09:30
MONITOR_EVENING_TIME=18:00
# Set to "false" to stop the scheduler in this process (e.g. when running several API replicas, keep it on in one).
MONITOR_SCHEDULER=true

# ---------- Web ----------
VITE_API_URL=http://localhost:4000/api
