# ---------- API ----------
PORT=4000
NODE_ENV=development
# SQLite for local dev. For Postgres use docker-compose (sets its own DATABASE_URL).
DATABASE_URL="file:./dev.db"
# JWT signing secret - generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
# 32-byte key (64 hex chars) for AES-256-GCM encryption of credentials / API keys
# generate with: openssl rand -hex 32
ENCRYPTION_KEY=
# Comma-separated allowed web origins
CORS_ORIGIN=http://localhost:5173
# Where uploaded files, screenshots, videos and traces are stored
STORAGE_DIR=./storage

# ---------- Seed admin (first run only) ----------
SEED_ADMIN_EMAIL=admin@qapilot.local
# In production (NODE_ENV=production, e.g. Docker) the API refuses to create the first Admin
# with this example password: set your own (12+ characters).
SEED_ADMIN_PASSWORD=ChangeMe!123
# Demo users (lead/tester/dev/client@qapilot.local, password Demo!2345) are created in development only,
# unless this is "true".
# SEED_DEMO_USERS=false

# ---------- Sign-in protection ----------
# Consecutive failed sign-ins before an account is locked, and for how long.
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
# Behind a reverse proxy, take the client IP from X-Forwarded-For (number of trusted hops). Docker sets 1.
# TRUST_PROXY=1

# ---------- Backup / restore ----------
# Largest backup accepted by "Restore from backup": upload size (compressed) and unpacked size, in MB.
BACKUP_UPLOAD_MAX_MB=1024
BACKUP_MAX_MB=2048

# ---------- AI layer (optional - rule-based fallback is used when unset) ----------
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# ---------- Scheduler (Phase 7) ----------
MONITOR_TIMEZONE=Asia/Kolkata
# Default check times (HH:MM in MONITOR_TIMEZONE); each project can change them on the Monitoring page.
MONITOR_MORNING_TIME=09:30
MONITOR_EVENING_TIME=18:00
# Set to "false" to stop the scheduler in this process (e.g. when running several API replicas, keep it on in one).
MONITOR_SCHEDULER=true

# ---------- Docker (docker-compose.yml) ----------
# POSTGRES_PASSWORD=change-me
# WEB_PORT=8080
# DEMO_PORT=4600

# ---------- Web ----------
VITE_API_URL=http://localhost:4000/api
